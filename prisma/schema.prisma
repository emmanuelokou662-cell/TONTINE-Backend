// Schéma Prisma pour la plateforme PWA de Gestion de Tontine
// Conforme au Cahier des Charges (Section 14) et aux exigences de sécurité bancaire

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id_utilisateur     String    @id @default(uuid())
  nom                String
  prenom             String
  contact_paiement   String    @unique
  email              String    @unique
  email_verifie      Boolean   @default(false)
  code_pin           String
  ville              String
  photo_profil_url   String
  tentatives_echouees Int      @default(0)
  blocage_jusqu_a    DateTime?
  theme_preference   String    @default("clair")
  push_subscription  String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  membres_groupes     MembreGroupe[]
  groupes_admin1      Groupe[]         @relation("AdminPrincipal")
  groupes_admin2      Groupe[]         @relation("AdminSecondaire")
  notifications       Notification[]
  messages_envoyes    Message[]        @relation("MessageExpediteur")
  messages_recus      Message[]        @relation("MessageDestinataire")
  validations_tx      Transaction[]    @relation("ValidateurTransaction")

  @@index([email])
  @@index([contact_paiement])
}

model Groupe {
  id_groupe           String   @id @default(uuid())
  nom_groupe          String
  mot_de_passe_groupe String
  id_admin_principal  String
  id_admin_secondaire String?
  periodicite         String   // "1semaine" | "2semaines" | "1mois" | "2mois"
  statut              String   @default("actif") // "actif" | "cloture"
  created_at          DateTime @default(now())

  admin_principal     Utilisateur    @relation("AdminPrincipal", fields: [id_admin_principal], references: [id_utilisateur])
  admin_secondaire    Utilisateur?   @relation("AdminSecondaire", fields: [id_admin_secondaire], references: [id_utilisateur])
  membres             MembreGroupe[]
  cycles              Cycle[]
  messages            Message[]
  notifications       Notification[]

  @@index([id_admin_principal])
}

model MembreGroupe {
  id                  String   @id @default(uuid())
  id_utilisateur      String
  id_groupe           String
  role                String   @default("membre") // "admin_principal" | "admin_secondaire" | "membre"
  statut              String   @default("actif")  // "actif" | "suspecte" | "retire"
  credit_reporte      Float    @default(0.0)
  retards_consecutifs Int      @default(0)
  date_adhesion       DateTime @default(now())

  utilisateur         Utilisateur   @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)
  groupe              Groupe        @relation(fields: [id_groupe], references: [id_groupe], onDelete: Cascade)
  tours               Tour[]
  transactions        Transaction[]

  @@unique([id_utilisateur, id_groupe])
  @@index([id_utilisateur])
  @@index([id_groupe])
}

model Cycle {
  id_cycle            String    @id @default(uuid())
  id_groupe           String
  numero_cycle        Int
  montant_cotisation  Float
  date_debut          DateTime  @default(now())
  date_fin            DateTime?
  statut              String    @default("en_cours") // "en_cours" | "termine"

  groupe              Groupe    @relation(fields: [id_groupe], references: [id_groupe], onDelete: Cascade)
  tours               Tour[]

  @@index([id_groupe])
}

model Tour {
  id_tour          String   @id @default(uuid())
  id_cycle         String
  id_membre_groupe String
  ordre_passage    Int
  date_prevue      DateTime
  statut           String   @default("en_attente") // "en_attente" | "distribue" | "saute"

  cycle            Cycle         @relation(fields: [id_cycle], references: [id_cycle], onDelete: Cascade)
  membre_groupe    MembreGroupe  @relation(fields: [id_membre_groupe], references: [id], onDelete: Cascade)
  transactions     Transaction[]

  @@index([id_cycle])
  @@index([id_membre_groupe])
}

model Transaction {
  id_transaction      String    @id @default(uuid())
  id_membre_groupe    String
  id_tour             String?
  type                String    // "depot" | "retrait"
  montant             Float
  moyen_paiement      String    // "MTN_Money" | "Wave"
  numero_tx_operateur String    @unique
  preuve_capture_url  String?
  statut              String    @default("en_attente") // "en_attente" | "confirme" | "rejete" | "reporte"
  motif_rejet         String?
  id_validateur       String?
  created_at          DateTime  @default(now())
  synced_at           DateTime?

  membre_groupe       MembreGroupe @relation(fields: [id_membre_groupe], references: [id], onDelete: Cascade)
  tour                Tour?        @relation(fields: [id_tour], references: [id_tour], onDelete: SetNull)
  validateur          Utilisateur? @relation("ValidateurTransaction", fields: [id_validateur], references: [id_utilisateur])

  @@index([id_membre_groupe])
  @@index([numero_tx_operateur])
}

model Notification {
  id_notification String   @id @default(uuid())
  id_utilisateur  String
  id_groupe       String?
  type            String   // "rappel_cotisation" | "validation" | "rejet" | "signalement" | "relance" | "distribution" | "nouveau_cycle"
  message         String
  lue             Boolean  @default(false)
  envoyee_push    Boolean  @default(false)
  created_at      DateTime @default(now())

  utilisateur     Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)
  groupe          Groupe?     @relation(fields: [id_groupe], references: [id_groupe], onDelete: Cascade)

  @@index([id_utilisateur])
  @@index([id_groupe])
}

model Message {
  id_message      String   @id @default(uuid())
  id_groupe       String
  id_expediteur   String
  id_destinataire String
  contenu         String
  lu              Boolean  @default(false)
  created_at      DateTime @default(now())

  groupe          Groupe      @relation(fields: [id_groupe], references: [id_groupe], onDelete: Cascade)
  expediteur      Utilisateur @relation("MessageExpediteur", fields: [id_expediteur], references: [id_utilisateur], onDelete: Cascade)
  destinataire    Utilisateur @relation("MessageDestinataire", fields: [id_destinataire], references: [id_utilisateur], onDelete: Cascade)

  @@index([id_groupe])
  @@index([id_expediteur])
  @@index([id_destinataire])
}

model OtpCode {
  id         String   @id @default(uuid())
  email      String
  code       String
  tentatives Int      @default(0)
  expire_a   DateTime
  utilise    Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email])
}
