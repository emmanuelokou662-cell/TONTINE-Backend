# ==============================================================================
# CONFIGURATION DES VARIABLES D'ENVIRONNEMENT - TONTINE BACKEND (MERN / MONGODB)
# ==============================================================================

# Environnement et Port
NODE_ENV=production
PORT=5000

# Base de données MongoDB (Atlas ou locale)
# Exemple MongoDB Atlas : mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/tontine_db?retryWrites=true&w=majority
# Exemple local : mongodb://127.0.0.1:27017/tontine_db
MONGODB_URI=mongodb+srv://admin:votre_mot_de_passe@cluster0.mongodb.net/tontine_db?retryWrites=true&w=majority

# Sécurité des Sessions et Jetons JWT (Minimum 32 caractères aléatoires)
JWT_SECRET=generer_une_cle_secrete_jwt_robuste_minimum_32_caracteres
JWT_REFRESH_SECRET=generer_une_cle_secrete_refresh_jwt_robuste_minimum_32_caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Configuration CORS - Origines autorisées (Frontend en local et/ou production)
# Séparez par des virgules pour autoriser plusieurs URLs
ALLOW_ORIGINS=http://localhost:5173,http://localhost:4173,https://votre-frontend-pwa.onrender.com

# Notifications Web Push (VAPID)
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckj0Ks2ln0GwHY49If80bmndyHUFVU
VAPID_PRIVATE_KEY=UUxI1Mm-QhQxYQ3iUeM9Hn7O8k9L8P7Y6R5T4W3Q2Z1
VAPID_SUBJECT=mailto:contact@tontine-pwa.ci

# Stockage des uploads (photos de profil, reçus de paiement Mobile Money)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
